{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/paper-topics.schema.json",
  "title": "论文库里的方向及篇数",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Response"
    },
    {
      "properties": {
        "kind": {
          "const": "paper-topics"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "label",
              "count"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    }
  ]
}
