{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/results-benchmark.schema.json",
  "title": "单个 benchmark 结果表",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Response"
    },
    {
      "properties": {
        "kind": {
          "const": "results-benchmark"
        }
      }
    },
    {
      "$ref": "common.schema.json#/$defs/Generated"
    },
    {
      "type": "object",
      "properties": {
        "benchmark": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "common.schema.json#/$defs/Text"
            },
            "name": {
              "$ref": "common.schema.json#/$defs/Text"
            },
            "category": {
              "$ref": "common.schema.json#/$defs/Text"
            },
            "split": {
              "type": "string"
            },
            "fullSize": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "metric": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "common.schema.json#/$defs/Text"
                },
                "higherIsBetter": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "higherIsBetter"
              ]
            }
          },
          "required": [
            "key",
            "name",
            "category",
            "split",
            "fullSize",
            "metric"
          ]
        },
        "stats": {
          "type": "object",
          "properties": {
            "methodCount": {
              "type": "integer",
              "minimum": 0
            },
            "paperCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "methodCount",
            "paperCount"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "paper": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/PaperRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "value": {
                "type": "number"
              },
              "scale": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "full",
                      "subset",
                      "unknown"
                    ]
                  },
                  "n": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "n"
                ]
              },
              "backboneModel": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "code": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "open",
                      "anonymous",
                      "none",
                      "unknown"
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "$ref": "common.schema.json#/$defs/Url"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stars": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "status",
                  "url",
                  "stars"
                ]
              },
              "source": {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "original",
                      "quoted"
                    ]
                  },
                  "paper": {
                    "$ref": "common.schema.json#/$defs/PaperRef"
                  },
                  "quotedFrom": {
                    "anyOf": [
                      {
                        "$ref": "common.schema.json#/$defs/PaperRef"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "location": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "type",
                  "paper",
                  "quotedFrom",
                  "location"
                ]
              },
              "isAblation": {
                "type": "boolean"
              },
              "cost": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "tokens": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "usd": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "llmCalls": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "tokens",
                      "usd",
                      "llmCalls"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "method",
              "paper",
              "value",
              "scale",
              "backboneModel",
              "code",
              "source",
              "isAblation",
              "cost"
            ]
          }
        }
      },
      "required": [
        "benchmark",
        "stats",
        "entries"
      ]
    }
  ]
}
