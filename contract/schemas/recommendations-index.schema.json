{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/recommendations-index.schema.json",
  "title": "往期推荐",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Response"
    },
    {
      "properties": {
        "kind": {
          "const": "recommendations-index"
        }
      }
    },
    {
      "$ref": "common.schema.json#/$defs/Generated"
    },
    {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "$ref": "common.schema.json#/$defs/Date"
              },
              "counts": {
                "type": "object",
                "properties": {
                  "core": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "adjacent": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "trending": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "core",
                  "adjacent",
                  "trending"
                ]
              },
              "pickedCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "date",
              "counts",
              "pickedCount"
            ]
          }
        }
      },
      "required": [
        "issues"
      ]
    }
  ]
}
