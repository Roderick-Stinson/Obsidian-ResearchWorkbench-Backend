{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/report.schema.json",
  "title": "报告正文",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Response"
    },
    {
      "properties": {
        "kind": {
          "const": "report"
        }
      }
    },
    {
      "$ref": "common.schema.json#/$defs/Generated"
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/Text"
        },
        "type": {
          "enum": [
            "weekly",
            "monthly"
          ]
        },
        "period": {
          "$ref": "common.schema.json#/$defs/Period"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/Text"
        },
        "markdown": {
          "$ref": "common.schema.json#/$defs/Text"
        }
      },
      "required": [
        "id",
        "type",
        "period",
        "title",
        "markdown"
      ]
    }
  ]
}
