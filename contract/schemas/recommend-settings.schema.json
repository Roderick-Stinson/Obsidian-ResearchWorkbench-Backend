{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/recommend-settings.schema.json",
  "title": "每日推荐设置",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Response"
    },
    {
      "properties": {
        "kind": {
          "const": "recommend-settings"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "time": {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            "maxCatchupDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "weeklyDay": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "required": [
            "enabled",
            "time",
            "maxCatchupDays",
            "weeklyDay"
          ],
          "additionalProperties": false
        },
        "sources": {
          "type": "object",
          "properties": {
            "huggingface": {
              "type": "boolean"
            },
            "streams": {
              "type": "object",
              "additionalProperties": {
                "type": "boolean"
              }
            }
          },
          "required": [
            "huggingface",
            "streams"
          ],
          "additionalProperties": false
        },
        "screen": {
          "type": "object",
          "properties": {
            "batchSize": {
              "type": "integer",
              "minimum": 5,
              "maximum": 100
            },
            "negativeExamples": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          },
          "required": [
            "batchSize",
            "negativeExamples"
          ],
          "additionalProperties": false
        },
        "adjacent": {
          "type": "object",
          "properties": {
            "seeds": {
              "type": "array",
              "items": {
                "enum": [
                  "own",
                  "watched",
                  "relevant",
                  "library"
                ]
              },
              "uniqueItems": true
            },
            "lookbackDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": [
            "seeds",
            "lookbackDays"
          ],
          "additionalProperties": false
        },
        "trending": {
          "type": "object",
          "properties": {
            "minHfUpvotes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "useHotspots": {
              "type": "boolean"
            },
            "hotspotMinHfUpvotes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "maxPerDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          },
          "required": [
            "minHfUpvotes",
            "useHotspots",
            "hotspotMinHfUpvotes",
            "maxPerDay"
          ],
          "additionalProperties": false
        },
        "skim": {
          "type": "object",
          "properties": {
            "fullText": {
              "type": "array",
              "items": {
                "enum": [
                  "core",
                  "adjacent",
                  "trending"
                ]
              },
              "uniqueItems": true
            },
            "maxFullTextPerDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          },
          "required": [
            "fullText",
            "maxFullTextPerDay"
          ],
          "additionalProperties": false
        },
        "pick": {
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "outsideMax": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "weights": {
              "type": "object",
              "properties": {
                "relevance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "quality": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "hf": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "code": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "max",
            "outsideMax",
            "weights"
          ],
          "additionalProperties": false
        },
        "weekly": {
          "type": "object",
          "properties": {
            "newAccepted": {
              "type": "boolean"
            },
            "map": {
              "type": "boolean"
            },
            "classics": {
              "type": "boolean"
            }
          },
          "required": [
            "newAccepted",
            "map",
            "classics"
          ],
          "additionalProperties": false
        },
        "library": {
          "type": "object",
          "properties": {
            "autoAdd": {
              "type": "array",
              "items": {
                "enum": [
                  "core",
                  "adjacent",
                  "trending"
                ]
              },
              "uniqueItems": true
            }
          },
          "required": [
            "autoAdd"
          ],
          "additionalProperties": false
        },
        "backlog": {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            }
          },
          "required": [
            "days",
            "max"
          ],
          "additionalProperties": false
        },
        "authors": {
          "type": "object",
          "properties": {
            "daily": {
              "type": "boolean"
            },
            "readPdf": {
              "type": "boolean"
            },
            "maxPerDay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "followRecommend": {
              "type": "boolean"
            }
          },
          "required": [
            "daily",
            "readPdf",
            "maxPerDay",
            "followRecommend"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "object",
          "properties": {
            "sections": {
              "type": "object",
              "properties": {
                "relation": {
                  "$ref": "common.schema.json#/$defs/Text"
                },
                "ideas": {
                  "$ref": "common.schema.json#/$defs/Text"
                },
                "follow": {
                  "$ref": "common.schema.json#/$defs/Text"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "screening": {
              "type": "boolean"
            },
            "asSeeds": {
              "type": "boolean"
            },
            "seedStatuses": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "uniqueItems": true
            },
            "seedMinRating": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "followToQueue": {
              "type": "boolean"
            },
            "candidates": {
              "type": "boolean"
            }
          },
          "required": [
            "sections",
            "screening",
            "asSeeds",
            "seedStatuses",
            "seedMinRating",
            "followToQueue",
            "candidates"
          ],
          "additionalProperties": false
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/DateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "query": {
                "$ref": "common.schema.json#/$defs/Text"
              }
            },
            "required": [
              "key",
              "name",
              "query"
            ]
          }
        },
        "profileProblem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schedule",
        "sources",
        "screen",
        "adjacent",
        "trending",
        "skim",
        "pick",
        "weekly",
        "library",
        "backlog",
        "authors",
        "notes",
        "updatedAt",
        "streams",
        "profileProblem"
      ]
    }
  ]
}
