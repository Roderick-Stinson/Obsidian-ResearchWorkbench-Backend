{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/jobs.schema.json",
  "title": "后台长任务进度",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Response"
    },
    {
      "properties": {
        "kind": {
          "const": "jobs"
        }
      }
    },
    {
      "$ref": "common.schema.json#/$defs/Generated"
    },
    {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "status": {
                "enum": [
                  "idle",
                  "running",
                  "stalled",
                  "done"
                ]
              },
              "progress": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "done": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "done",
                      "total"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "message": {
                "type": "string"
              },
              "updatedAt": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/DateTime"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key",
              "name",
              "status",
              "progress",
              "message",
              "updatedAt"
            ]
          }
        }
      },
      "required": [
        "items"
      ]
    }
  ]
}
