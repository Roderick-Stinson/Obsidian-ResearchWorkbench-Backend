{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/task-create.schema.json",
  "title": "创建后台任务",
  "type": "object",
  "properties": {
    "type": {
      "enum": [
        "deep-read",
        "generate-report",
        "rebuild-map",
        "rebuild-classics",
        "rebuild-interests",
        "run-daily",
        "retry-step",
        "classify-scheme",
        "suggest-schemes",
        "rebuild-affiliations",
        "ingest-paper",
        "claim-run"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "params"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "deep-read"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "paperId": {
                "$ref": "common.schema.json#/$defs/PaperId"
              }
            },
            "required": [
              "paperId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "generate-report"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "weekly",
                  "monthly"
                ]
              },
              "period": {
                "$ref": "common.schema.json#/$defs/Period"
              }
            },
            "required": [
              "type",
              "period"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rebuild-map"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rebuild-classics"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rebuild-interests"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run-daily"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "retry-step"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "runId": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "step": {
                "enum": [
                  "fetch",
                  "version-check",
                  "affiliations",
                  "summaries",
                  "notes",
                  "classify",
                  "skim",
                  "recommend",
                  "pick",
                  "new-accepted",
                  "deep-read",
                  "results",
                  "map",
                  "must-read",
                  "classics",
                  "interests",
                  "research-lines",
                  "hotspots",
                  "report",
                  "push"
                ]
              }
            },
            "required": [
              "runId",
              "step"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "classify-scheme"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "schemeId": {
                "$ref": "common.schema.json#/$defs/Text"
              }
            },
            "required": [
              "schemeId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "suggest-schemes"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "topic",
                      "query",
                      "watched",
                      "own",
                      "all"
                    ]
                  },
                  "value": {
                    "$ref": "common.schema.json#/$defs/Text"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "scope"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "rebuild-affiliations"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "refresh": {
                "type": "boolean"
              },
              "readPdf": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ingest-paper"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "url": {
                "$ref": "common.schema.json#/$defs/Url"
              },
              "watch": {
                "type": "boolean"
              }
            },
            "required": [
              "url",
              "watch"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "claim-run"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "runId": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "target": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "paper",
                      "reproGroup",
                      "experimentNote"
                    ]
                  },
                  "id": {
                    "$ref": "common.schema.json#/$defs/Text"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ]
              }
            },
            "required": [
              "runId",
              "target"
            ]
          }
        }
      }
    }
  ]
}
