{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-workbench.local/schemas/follows.schema.json",
  "title": "关注的人",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/Response"
    },
    {
      "properties": {
        "kind": {
          "const": "follows"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/Text"
              },
              "openalexId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "institution": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "institutionName": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "followedAt": {
                "$ref": "common.schema.json#/$defs/DateTime"
              }
            },
            "required": [
              "key",
              "name",
              "openalexId",
              "institution",
              "institutionName",
              "followedAt"
            ]
          }
        },
        "updatedAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/DateTime"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "people",
        "updatedAt"
      ]
    }
  ]
}
